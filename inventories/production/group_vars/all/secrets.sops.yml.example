# Structure reference for secrets.sops.yml. Committed in plain text
# because it holds no values. See ADR 0008.
#
#   age-keygen -o age-key.txt
#   export SOPS_AGE_KEY_FILE=./age-key.txt
#   cp secrets.sops.yml.example secrets.sops.yml
#   sops --encrypt --age <public-key> --in-place secrets.sops.yml
#
# Subsequent edits: sops secrets.sops.yml
# Keys are added here as the services that require them are deployed.

notify_webhook_url: ""
